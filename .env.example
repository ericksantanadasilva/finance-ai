# Variáveis de ambiente do financeiro. Copie para .env e preencha; nunca versione o .env.
# "Nova" = ainda não existe no deploy atual (main); precisa ser criada na VPS na publicação.

# Banco Postgres (Prisma). Em dev aponta para o finance_dev; em produção, para o finance.
DATABASE_URL=

# next-auth (lidas pela própria biblioteca, sem process.env no código)
# URL pública do site web, usada nos redirects do login.
NEXTAUTH_URL=
# Segredo que assina a sessão do web. Não trocar: desloga todo mundo.
NEXTAUTH_SECRET=

# Login com Google: client OAuth do tipo web (web e o webClientId do app).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini: chat e importação por IA.
GEMINI_API_KEY=

# Chave x-api-key das rotas /api/integrations (n8n).
N8N_INTERNAL_SECRET=

# Nova. Segredo dos access tokens do app mobile (32 caracteres ou mais).
MOBILE_JWT_SECRET=
# Nova. Client IDs Android/iOS do Google aceitos no login do app, separados por vírgula.
GOOGLE_MOBILE_CLIENT_IDS=
# Nova. Token do robô (papel Viewer) da Expo para enviar push; exigido pelo Enhanced Security.
EXPO_ACCESS_TOKEN=
