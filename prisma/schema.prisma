generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  categories   Category[]
  goals        Goal[]
  settings     Json?
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("bg-zinc-500")
  type      String // "income" or "expense" (minusculo)
  userId    String
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([name, userId])
}

model Transaction {
  id          String   @id @default(cuid())
  description String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime

  referenceDate DateTime @default(now())

  type        String // "income" or "expense" (minusculo)
  isRecurring Boolean @default(false)
  isPaid      Boolean @default(true)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  aiGenerated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referenceDate]) //Index para buscaas rápidas no dashboard
}

model Goal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Decimal   @db.Decimal(10, 2)
  currentAmount Decimal   @default(0) @db.Decimal(10, 2)
  deadline      DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExternalIdentity {
  id             String   @id @default(uuid())
  userId         String   @map("user_id") // UUID do usuário no sistema/Supabase
  provider       String   // 'telegram', 'discord', 'whatsapp', 'web'
  providerUserId String   @map("provider_user_id") // Chat ID do Telegram, ID do Discord, etc.
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([provider, providerUserId])
  @@map("external_identities")
}

model LinkToken {
  token     String   @id // Código alfanumérico curto (ex: 6 dígitos)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")

  @@map("link_tokens")
}
