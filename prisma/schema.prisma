generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

enum TransactionType {
  income
  expense
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  imageUrl  String?
  passwordHash String? // bcrypt; null em contas que só entram pelo Google
  googleId  String?  @unique // "sub" da conta Google vinculada
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions   Transaction[]
  categories     Category[]
  goals          Goal[]
  recurringRules RecurringRule[]
  mobileSessions MobileSession[]
  pushDevices    PushDevice[]
  notificationLogs NotificationLog[]
  settings       Json?
}

// Sessão do app mobile: uma por aparelho. Guarda só o hash (SHA-256) do refresh
// token; o token em si fica apenas no aparelho. Revogar = preencher revokedAt.
model MobileSession {
  id               String    @id @default(cuid())
  refreshTokenHash String    @unique // trocado a cada refresh (rotação)
  deviceName       String? // ex: "iPhone de Erick", informado pelo app
  platform         String? // 'ios' | 'android'
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pushDevices PushDevice[]

  @@index([userId])
}

// Aparelho que recebe push (Expo). Pertence à instalação, como a sessão: só
// recebe com disabledAt nulo e a MobileSession ativa (logout desliga o push).
model PushDevice {
  id            String    @id @default(cuid())
  expoPushToken String    @unique // ExponentPushToken[...]; upsert ao trocar de conta
  platform      String // 'android' (iOS depois)
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now()) // atualizado a cada POST /devices
  disabledAt    DateTime? // logout, DELETE /devices/:id ou DeviceNotRegistered

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mobileSessionId String
  mobileSession   MobileSession @relation(fields: [mobileSessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mobileSessionId])
}

// Aviso já enviado. Gravado antes do envio: a chave única impede repetir o
// mesmo aviso (ex.: budget:<catId>:2026-11:80), inclusive num retry do n8n.
model NotificationLog {
  id                String    @id @default(cuid())
  kind              String // 'due' | 'overdue' | 'budget'
  dedupeKey         String
  sentAt            DateTime  @default(now())
  tickets           Json? // [{ deviceId, ticketId }] para conferir os recibos da Expo
  receiptsCheckedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("bg-zinc-500")
  type      TransactionType
  budget    Decimal? @db.Decimal(10, 2) // limite mensal de gastos (null = sem limite)
  // Nome comparável: minúsculas, sem os espaços das pontas. Nulo só até a migration que o torna obrigatório (9h)
  nameKey    String?
  archivedAt DateTime? // arquivada (soft delete): fora das listas de escolha, mantida no histórico
  userId    String
  createdAt DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurringRules RecurringRule[]

  @@unique([name, userId])
  @@unique([userId, nameKey])
}

model Transaction {
  id          String   @id @default(cuid())
  description String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime

  referenceDate DateTime @default(now())

  type        TransactionType
  isRecurring Boolean @default(false)
  isPaid      Boolean @default(true)

  // Preenchido quando a transação foi gerada por uma regra recorrente
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  aiGenerated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recurringRuleId, referenceDate]) // uma ocorrência por regra/mês (nulls não conflitam)
  @@index([referenceDate]) //Index para buscaas rápidas no dashboard
  @@index([userId, referenceDate]) // toda consulta filtra pelo usuário antes do mês
}

// Regra de lançamento mensal (aluguel, assinaturas, salário...)
model RecurringRule {
  id                 String   @id @default(cuid())
  description        String
  amount             Decimal  @db.Decimal(10, 2)
  type               TransactionType
  dayOfMonth         Int // 1-31; em meses curtos usa o último dia
  startMonth         String // "YYYY-MM" primeiro mês a gerar
  // Último mês já gerado ("YYYY-MM"). Impede recriar uma ocorrência que o usuário apagou.
  lastGeneratedMonth String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@index([userId])
}

model Goal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Decimal   @db.Decimal(10, 2)
  currentAmount Decimal   @default(0) @db.Decimal(10, 2)
  deadline      DateTime?
  // Início do ritmo da meta (app mobile). As metas antigas receberam o
  // instante embutido no id (cuid v1) na migration add_goal_created_at
  createdAt     DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExternalIdentity {
  id             String   @id @default(uuid())
  userId         String   @map("user_id") // id do User
  provider       String // 'telegram', 'discord', 'whatsapp', 'web'
  providerUserId String   @map("provider_user_id") // Chat ID do Telegram, ID do Discord, etc.
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([provider, providerUserId])
  @@map("external_identities")
}

model LinkToken {
  token     String   @id // Código alfanumérico curto (ex: 6 dígitos)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")

  @@map("link_tokens")
}
