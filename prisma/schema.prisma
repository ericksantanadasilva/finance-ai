generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions   Transaction[]
  categories     Category[]
  goals          Goal[]
  recurringRules RecurringRule[]
  settings       Json?
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("bg-zinc-500")
  type      String // "income" or "expense" (minusculo)
  budget    Decimal? @db.Decimal(10, 2) // limite mensal de gastos (null = sem limite)
  userId    String
  createdAt DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurringRules RecurringRule[]

  @@unique([name, userId])
}

model Transaction {
  id          String   @id @default(cuid())
  description String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime

  referenceDate DateTime @default(now())

  type        String // "income" or "expense" (minusculo)
  isRecurring Boolean @default(false)
  isPaid      Boolean @default(true)

  // Preenchido quando a transação foi gerada por uma regra recorrente
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  aiGenerated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recurringRuleId, referenceDate]) // uma ocorrência por regra/mês (nulls não conflitam)
  @@index([referenceDate]) //Index para buscaas rápidas no dashboard
}

// Regra de lançamento mensal (aluguel, assinaturas, salário...)
model RecurringRule {
  id                 String   @id @default(cuid())
  description        String
  amount             Decimal  @db.Decimal(10, 2)
  type               String // "income" or "expense"
  dayOfMonth         Int // 1-31; em meses curtos usa o último dia
  startMonth         String // "YYYY-MM" primeiro mês a gerar
  // Último mês já gerado ("YYYY-MM"). Impede recriar uma ocorrência que o usuário apagou.
  lastGeneratedMonth String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@index([userId])
}

model Goal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Decimal   @db.Decimal(10, 2)
  currentAmount Decimal   @default(0) @db.Decimal(10, 2)
  deadline      DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExternalIdentity {
  id             String   @id @default(uuid())
  userId         String   @map("user_id") // UUID do usuário no sistema/Supabase
  provider       String // 'telegram', 'discord', 'whatsapp', 'web'
  providerUserId String   @map("provider_user_id") // Chat ID do Telegram, ID do Discord, etc.
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([provider, providerUserId])
  @@map("external_identities")
}

model LinkToken {
  token     String   @id // Código alfanumérico curto (ex: 6 dígitos)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")

  @@map("link_tokens")
}
